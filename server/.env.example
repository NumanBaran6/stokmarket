# Sunucu portu (macOS'ta 5000 AirPlay tarafından kullanılır, 5001 önerilir)
PORT=5001

# Çalışma ortamı: development | production
NODE_ENV=development

# MongoDB bağlantı adresi.
# Boş bırakılırsa geliştirme ortamında otomatik olarak in-memory (geçici) veritabanı başlatılır.
# Canlı / kalıcı kullanım için MongoDB Atlas bağlantı dizesini buraya yazın:
# MONGODB_URI=mongodb+srv://kullanici:sifre@cluster0.xxxxx.mongodb.net/stokmarket?retryWrites=true&w=majority
MONGODB_URI=

# JWT (kimlik doğrulama) ayarları - PRODUCTION'DA MUTLAKA DEĞİŞTİRİN
JWT_SECRET=stokmarket_super_gizli_anahtar_degistirin
JWT_EXPIRE=7d

# Frontend adresi (CORS izni için)
CLIENT_URL=http://localhost:5173
